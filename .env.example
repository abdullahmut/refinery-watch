# Not read by any code yet. For jobs not yet built: extraction, monitoring and the cost cap.
ANTHROPIC_API_KEY=
SENTRY_DSN=
ALERT_EMAIL_TO=
DAILY_COST_CAP_USD=1.50

# Mail. App.
RESEND_API_KEY=
NOTE_RECIPIENTS=

# Data Droplet only. Postgres superuser password and the VPC bind address.
POSTGRES_PASSWORD=
DATA_BIND_ADDR=

CONTACT_EMAIL=
EIA_API_KEY=
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=

# Postgres, app role. APP_DATABASE_URL replaces the five PG_* app keys; never set it with
# PG_HOST or PG_APP_PASSWORD.
PG_HOST=
PG_PORT=5432
PG_DATABASE=refinery_watch
PG_APP_USER=refinery_app
PG_APP_PASSWORD=

# Postgres, owner role, for migrate and seed only. OWNER_DATABASE_URL replaces these; never set
# it with PG_HOST or PG_OWNER_PASSWORD. PG_OWNER_PASSWORD is stored only in the data Droplet's
# .env, for Postgres init. Never on app or ingest. Type it in the shell to migrate or seed.
PG_OWNER_USER=refinery_owner
PG_OWNER_PASSWORD=

# Optional full URLs. Leave unset to use the PG_* keys.
# APP_DATABASE_URL=
# OWNER_DATABASE_URL=

# Cloudflare R2 raw bucket, over the S3 API. Ingest writes, app reads.
OBJECT_STORE_REGION=auto
OBJECT_STORE_BUCKET_RAW=

# Data Droplet only. For the backup job, which is not built yet.
OBJECT_STORE_BUCKET_BACKUP=
OBJECT_STORE_BACKUP_ACCESS_KEY=
OBJECT_STORE_BACKUP_SECRET_KEY=

# Fetching and reference data.
FETCH_IPV6=0
REFINERIES_CSV_PATH=

# Flare signal. FIRMS_MAP_KEY on ingest; the alert keys on app; locations on ingest.
FIRMS_MAP_KEY=
NOTE_FROM=
FLARE_ALERT_DAILY_MAX=10
REFINERY_LOCATIONS_CSV_PATH=
